<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.frexal.dalmendra.app.ui.categorias.CategoriasController"
            prefWidth="820.0"
            prefHeight="320.0"
            minWidth="820.0"
            minHeight="320.0"
            maxWidth="820.0"
            maxHeight="320.0"
            style="-fx-background-color: #f0f0f0;">

    <children>
        <ToolBar layoutX="0.0"
                 layoutY="0.0"
                 prefWidth="820.0"
                 prefHeight="32.0">
            <items>
                <Button fx:id="btnNuevo"
                        text="Nuevo"
                        onAction="#onNuevo"
                        prefWidth="65.0" />

                <Button fx:id="btnEditar"
                        text="Editar"
                        onAction="#onEditar"
                        prefWidth="65.0"
                        disable="true" />

                <Button fx:id="btnGuardar"
                        text="Guardar"
                        onAction="#onGuardar"
                        prefWidth="75.0"
                        disable="true" />

                <Button fx:id="btnEliminar"
                        text="Eliminar"
                        onAction="#onEliminar"
                        prefWidth="75.0"
                        disable="true" />

                <Button fx:id="btnCancelar"
                        text="Cancelar"
                        onAction="#onCancelar"
                        prefWidth="80.0"
                        disable="true" />

                <Button fx:id="btnOrdenar"
                        text="Ordenar"
                        onAction="#onOrdenar"
                        prefWidth="75.0" />

                <Button fx:id="btnInicio"
                        text="Inicio"
                        onAction="#onInicio"
                        prefWidth="65.0"
                        disable="true" />

                <Button fx:id="btnSubir"
                        text="Subir"
                        onAction="#onSubir"
                        prefWidth="65.0"
                        disable="true" />

                <Button fx:id="btnBajar"
                        text="Bajar"
                        onAction="#onBajar"
                        prefWidth="65.0"
                        disable="true" />

                <Button fx:id="btnFinal"
                        text="Final"
                        onAction="#onFinal"
                        prefWidth="65.0"
                        disable="true" />

                <Button fx:id="btnCerrar"
                        text="Cerrar"
                        onAction="#onCerrar"
                        prefWidth="70.0" />
            </items>
        </ToolBar>

        <AnchorPane layoutX="12.0"
                    layoutY="40.0"
                    prefWidth="776.0"
                    prefHeight="266.0"
                    style="-fx-background-color: white; -fx-border-color: #bcbcbc; -fx-border-width: 1;">
            <children>
                <Label layoutX="10.0"
                       layoutY="6.0"
                       text="Categorías">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>

                <Label layoutX="12.0"
                       layoutY="34.0"
                       text="ID:" />

                <Label fx:id="lblId"
                       layoutX="36.0"
                       layoutY="34.0"
                       prefWidth="120.0"
                       text="" />

                <Label layoutX="12.0"
                       layoutY="61.0"
                       text="Descripción" />

                <TextField fx:id="txtDescripcion"
                           layoutX="12.0"
                           layoutY="79.0"
                           prefWidth="160.0"
                           disable="true" />

                <Label layoutX="12.0"
                       layoutY="113.0"
                       text="Palabra Clave" />

                <TextField fx:id="txtPalabraClave"
                           layoutX="12.0"
                           layoutY="131.0"
                           prefWidth="160.0"
                           disable="true" />

                <CheckBox fx:id="ckbEstado"
                          layoutX="12.0"
                          layoutY="168.0"
                          text="Activo"
                          selected="true"
                          disable="true" />

                <TableView fx:id="tblCategorias"
                           layoutX="190.0"
                           layoutY="20.0"
                           prefWidth="570.0"
                           prefHeight="228.0">
                    <columns>
                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="60.0" />
                        <TableColumn fx:id="colDescripcion"
                                     text="Descripción"
                                     prefWidth="210.0" />
                        <TableColumn fx:id="colPalabraClave"
                                     text="Palabra Clave"
                                     prefWidth="180.0" />
                        <TableColumn fx:id="colEstado"
                                     text="Estado"
                                     prefWidth="118.0" />
                    </columns>
                </TableView>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>