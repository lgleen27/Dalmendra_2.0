<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.frexal.dalmendra.app.ui.config.ConfiguracionController"
            prefWidth="480"
            prefHeight="280"
            style="-fx-background-color: white;">

    <center>
        <VBox spacing="16" alignment="CENTER_LEFT">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label minWidth="170" text="Reporte al iniciar:" />
                <ComboBox fx:id="cmbReporte" prefWidth="180"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label minWidth="170" text="Intervalo de sincronización:" />
                <Spinner fx:id="spnSync" prefWidth="90"/>
                <Label text="Minutos"/>
            </HBox>

            <Label text="El 0 inactiva esta función."
                   style="-fx-text-fill: #a00000; -fx-font-size: 11px;"
                   translateX="182"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label minWidth="170" text="Cambio de sucursal:" />
                <Spinner fx:id="spnCambio" prefWidth="90"/>
                <Label text="Minutos"/>
            </HBox>

            <Label text="El 0 inactiva esta función."
                   style="-fx-text-fill: #a00000; -fx-font-size: 11px;"
                   translateX="182"/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER" style="-fx-padding: 0 0 20 0;">
            <children>
                <Button text="Guardar" onAction="#onGuardar" prefWidth="100"/>
                <Button text="Cancelar" onAction="#onCancelar" prefWidth="100"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>