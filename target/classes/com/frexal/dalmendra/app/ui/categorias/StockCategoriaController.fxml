
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/13"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.frexal.dalmendra.app.ui.categorias.StockCategoriaController"
      spacing="10.0"
      prefWidth="260.0"
      prefHeight="180.0"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <children>
        <Label fx:id="lblCategoria" text="Categoría"/>

        <Label text="Stock mínimo"/>
        <TextField fx:id="txtStockMinimo"/>

        <Label text="Stock deseado"/>
        <TextField fx:id="txtStockDeseado"/>

        <HBox spacing="10.0">
            <children>
                <Button text="Guardar" onAction="#onGuardar"/>
                <Button text="Cancelar" onAction="#onCancelar"/>
            </children>
        </HBox>
    </children>
</VBox>