<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.frexal.dalmendra.app.ui.main.MainController">

    <top>
        <MenuBar>
            <menus>
                <Menu text="Reportes">
                    <items>
                        <MenuItem text="Por Categorias" onAction="#onReportePorCategorias"/>
                        <MenuItem text="Listado con Codigo" onAction="#onListadoConCodigo"/>
                        <MenuItem text="Listado sin Codigo" onAction="#onListadoSinCodigo"/>
                    </items>
                </Menu>

                <Menu text="Catalogos">
                    <items>
                        <MenuItem text="Sucursales" onAction="#onSucursales"/>
                        <MenuItem text="Categorias" onAction="#onCategorias"/>
                        <MenuItem text="Articulos" onAction="#onArticulos"/>
                        <SeparatorMenuItem />
                        <MenuItem text="Configuración" onAction="#onConfiguracion"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: white;">
            <children>
                <Label fx:id="lblVistaActual" text="Bienvenido a Dalmendra" style="-fx-font-size: 22px; -fx-text-fill: #333333;" />
            </children>
        </StackPane>
    </center>

    <bottom>
        <HBox spacing="12" style="-fx-background-color: #f4f4f4; -fx-border-color: #d9d9d9; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="8" right="12" bottom="8" left="12"/>
            </padding>
            <children>
                <Label text="Estado:" />
                <Label fx:id="lblEstado" text="Inicializando..." />
                <Label text="|" />
                <Label text="Sincronización:" />
                <Label fx:id="lblSync" text="Sin iniciar" />
            </children>
        </HBox>
    </bottom>
</BorderPane>